# ============================================================
# InstallWindowsRuntime.cmake
#
# Collects Windows runtime DLLs for a MinGW cross-compiled
# executable.
#
# The script:
#
#   1. runs ntldd on the installed executable,
#   2. extracts DLL names from its output,
#   3. asks the selected C++ compiler for its library paths,
#   4. searches those paths for the DLLs,
#   5. copies every matching DLL next to the executable.
#
# No DLL names, GCC versions or MinGW paths are hardcoded.
# ============================================================


# ============================================================
# Configuration supplied by CMake at configure time
# ============================================================

set(WINDOWS_CXX_COMPILER
    "@CMAKE_CXX_COMPILER@"
)

set(WINDOWS_NTLDD_EXECUTABLE
    "@NTLDD_EXECUTABLE@"
)

set(WINDOWS_INSTALL_BINDIR
    "@CMAKE_INSTALL_BINDIR@"
)


# ============================================================
# Determine installation paths
# ============================================================

set(WINDOWS_INSTALL_DIRECTORY
    "${CMAKE_INSTALL_PREFIX}/${WINDOWS_INSTALL_BINDIR}"
)

set(WINDOWS_EXECUTABLE
    "${WINDOWS_INSTALL_DIRECTORY}/main.exe"
)


# ============================================================
# Basic validation
# ============================================================

if(NOT EXISTS "${WINDOWS_NTLDD_EXECUTABLE}")

    message(FATAL_ERROR
        "ntldd was not found:\n"
        "  ${WINDOWS_NTLDD_EXECUTABLE}"
    )

endif()


if(NOT EXISTS "${WINDOWS_CXX_COMPILER}")

    message(FATAL_ERROR
        "C++ compiler was not found:\n"
        "  ${WINDOWS_CXX_COMPILER}"
    )

endif()


if(NOT EXISTS "${WINDOWS_EXECUTABLE}")

    message(FATAL_ERROR
        "Installed executable was not found:\n"
        "  ${WINDOWS_EXECUTABLE}"
    )

endif()


message(STATUS
    "Collecting Windows runtime dependencies"
)

message(STATUS
    "Executable: ${WINDOWS_EXECUTABLE}"
)

message(STATUS
    "C++ compiler: ${WINDOWS_CXX_COMPILER}"
)

message(STATUS
    "ntldd: ${WINDOWS_NTLDD_EXECUTABLE}"
)


# ============================================================
# Ask GCC for its library search directories
# ============================================================

execute_process(
    COMMAND
        "${WINDOWS_CXX_COMPILER}"
        -print-search-dirs

    RESULT_VARIABLE
        GCC_RESULT

    OUTPUT_VARIABLE
        GCC_SEARCH_DIRS

    ERROR_VARIABLE
        GCC_ERROR

    OUTPUT_STRIP_TRAILING_WHITESPACE
)


if(NOT GCC_RESULT EQUAL 0)

    message(FATAL_ERROR
        "Could not obtain GCC search directories.\n"
        "Compiler:\n"
        "  ${WINDOWS_CXX_COMPILER}\n\n"
        "Error:\n"
        "${GCC_ERROR}"
    )

endif()


message(STATUS
    "GCC search directories:"
)

message(STATUS
    "${GCC_SEARCH_DIRS}"
)


# ============================================================
# Extract "libraries:" line
# ============================================================

string(
    REGEX MATCH
    "libraries:[^\n]*"
    GCC_LIBRARIES_LINE
    "${GCC_SEARCH_DIRS}"
)


if(NOT GCC_LIBRARIES_LINE)

    message(FATAL_ERROR
        "Could not find GCC 'libraries:' search path."
    )

endif()


# Remove:
#
#     libraries: =
#
# leaving only the path list.

string(
    REGEX REPLACE
    "^libraries:[ ]*=[ ]*"
    ""
    GCC_LIBRARY_PATHS
    "${GCC_LIBRARIES_LINE}"
)


# GCC uses ':' as a path separator on Linux.

string(
    REPLACE
    ":"
    ";"
    GCC_LIBRARY_PATHS
    "${GCC_LIBRARY_PATHS}"
)


# ============================================================
# Normalize and validate GCC paths
# ============================================================

set(
    GCC_VALID_LIBRARY_PATHS
    ""
)


foreach(PATH IN LISTS GCC_LIBRARY_PATHS)

    # Remove trailing slash.

    string(
        REGEX REPLACE
        "/$"
        ""
        PATH
        "${PATH}"
    )


    # Normalize the path.

    get_filename_component(
        PATH
        "${PATH}"
        ABSOLUTE
    )


    if(IS_DIRECTORY "${PATH}")

        list(
            APPEND
            GCC_VALID_LIBRARY_PATHS
            "${PATH}"
        )

    endif()

endforeach()


# Remove duplicate directories.

list(
    REMOVE_DUPLICATES
    GCC_VALID_LIBRARY_PATHS
)


message(STATUS
    "Using GCC library paths:"
)

foreach(PATH IN LISTS GCC_VALID_LIBRARY_PATHS)

    message(
        STATUS
        "  ${PATH}"
    )

endforeach()


# ============================================================
# Run ntldd
# ============================================================

message(
    STATUS
    "Running ntldd..."
)


execute_process(
    COMMAND
        "${WINDOWS_NTLDD_EXECUTABLE}"
        "-R"
        "${WINDOWS_EXECUTABLE}"

    RESULT_VARIABLE
        NTLDD_RESULT

    OUTPUT_VARIABLE
        NTLDD_OUTPUT

    ERROR_VARIABLE
        NTLDD_ERROR
)


if(NOT NTLDD_RESULT EQUAL 0)

    message(FATAL_ERROR
        "ntldd failed.\n\n"
        "Output:\n"
        "${NTLDD_OUTPUT}\n\n"
        "Error:\n"
        "${NTLDD_ERROR}"
    )

endif()


message(
    STATUS
    "ntldd output:"
)

message(
    STATUS
    "${NTLDD_OUTPUT}"
)


# ============================================================
# Convert ntldd output into individual lines
# ============================================================

string(
    REPLACE
    "\r\n"
    "\n"
    NTLDD_OUTPUT
    "${NTLDD_OUTPUT}"
)

string(
    REPLACE
    "\n"
    ";"
    NTLDD_LINES
    "${NTLDD_OUTPUT}"
)


# ============================================================
# Process every DLL reported by ntldd
# ============================================================

foreach(LINE IN LISTS NTLDD_LINES)

    # Expected format:
    #
    #     libstdc++-6.dll => not found
    #
    # or:
    #
    #     libstdc++-6.dll => Z:\...\libstdc++-6.dll (0x...)
    #

    if(
        LINE MATCHES
        "^[ \t]*([^ \t]+\\.dll)[ \t]+=>"
    )

        set(
            DLL_NAME
            "${CMAKE_MATCH_1}"
        )


        message(
            STATUS
            "Searching for: ${DLL_NAME}"
        )


        unset(DLL_PATH)


        # ====================================================
        # Search every GCC library directory
        # ====================================================

        foreach(PATH IN LISTS GCC_VALID_LIBRARY_PATHS)

            if(
                EXISTS
                "${PATH}/${DLL_NAME}"
            )

                set(
                    DLL_PATH
                    "${PATH}/${DLL_NAME}"
                )

                break()

            endif()

        endforeach()


        # ====================================================
        # Install found DLL
        # ====================================================

        if(DLL_PATH)

            message(
                STATUS
                "Installing Windows runtime dependency:"
            )

            message(
                STATUS
                "  ${DLL_PATH}"
            )


            file(
                INSTALL
                DESTINATION
                    "${WINDOWS_INSTALL_DIRECTORY}"

                TYPE FILE

                FILES
                    "${DLL_PATH}"
            )

        endif()

    endif()

endforeach()


# ============================================================
# Finished
# ============================================================

message(
    STATUS
    "Windows runtime dependency collection finished."
)